new file mode 100644
index 00000000000..c7eb0a179d2
--- /dev/null
+++ b/net/base/crgost_egress.cc
@@ -0,0 +1,91 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/base/crgost_egress.h"
+
+#include <algorithm>
+
+#include "base/environment.h"
+#include "base/logging.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace net {
+
+namespace {
+
+using internal::ComputeAnnotationHash;
+
+constexpr int32_t kPageTraffic[] = {
+    ComputeAnnotationHash("navigation_url_loader"),
+    ComputeAnnotationHash("blink_resource_loader"),
+    ComputeAnnotationHash("blink_extension_resource_loader"),
+    ComputeAnnotationHash("blink_fetch_later_manager"),
+    ComputeAnnotationHash("favicon_loader"),
+    ComputeAnnotationHash("keepalive_fetch_retry"),
+    ComputeAnnotationHash("background_fetch_context"),
+    ComputeAnnotationHash("early_hints_preload"),
+    ComputeAnnotationHash("webauthn_rp_id_check"),
+    ComputeAnnotationHash("websocket_stream"),
+    ComputeAnnotationHash("webrtc_peer_connection"),
+    ComputeAnnotationHash("webrtc_rtc_transport"),
+    ComputeAnnotationHash("direct_sockets"),
+    ComputeAnnotationHash("worker_script_load"),
+    ComputeAnnotationHash("service_worker_script_load"),
+    ComputeAnnotationHash("service_worker_update_checker"),
+    ComputeAnnotationHash("service_worker_navigation_preload"),
+    ComputeAnnotationHash("service_worker_race_network_request"),
+    ComputeAnnotationHash("shared_storage_worklet_module_script_downloader"),
+    ComputeAnnotationHash("speculation_rules_prefetch"),
+    ComputeAnnotationHash("speculation_rules_prefetch_probe"),
+    ComputeAnnotationHash("sigined_exchange_cert_fetcher"),
+    ComputeAnnotationHash("payment_manifest_downloader"),
+    ComputeAnnotationHash("fedcm"),
+    ComputeAnnotationHash("renderer_initiated_download"),
+    ComputeAnnotationHash("download_web_contents_frame"),
+    ComputeAnnotationHash("download_manager_resume"),
+    ComputeAnnotationHash("download_bubble_retry_download"),
+    ComputeAnnotationHash("drag_download_file"),
+    ComputeAnnotationHash("render_view_context_menu"),
+    ComputeAnnotationHash("downloads_dom_handler"),
+    ComputeAnnotationHash("downloads_api_run_async"),
+    ComputeAnnotationHash("parallel_download_job"),
+    ComputeAnnotationHash("save_file_manager"),
+    ComputeAnnotationHash("devtools_network_resource"),
+    ComputeAnnotationHash("devtools_cdp_network_resource"),
+    ComputeAnnotationHash("dns_transaction"),
+    ComputeAnnotationHash("dns_over_https"),
+    ComputeAnnotationHash("proxy_config_system"),
+    ComputeAnnotationHash("proxy_config_settings"),
+    ComputeAnnotationHash("proxy_config_direct"),
+    ComputeAnnotationHash("certificate_verifier_url_loader"),
+    ComputeAnnotationHash("certificate_verifier_url_request"),
+    ComputeAnnotationHash("omnibox_suggest"),
+    ComputeAnnotationHash("extension_manifest_fetcher"),
+    ComputeAnnotationHash("extension_crx_fetcher"),
+    ComputeAnnotationHash("webstore_installer"),
+    ComputeAnnotationHash("webstore_install_helper"),
+    ComputeAnnotationHash("cws_fetch_item_snippet"),
+    ComputeAnnotationHash("update_client"),
+};
+
+bool LogOnly() {
+  static const bool log_only =
+      base::Environment::Create()->GetVar("CRGOST_EGRESS") == "log";
+  return log_only;
+}
+
+}  // namespace
+
+bool CrgostEgressAllowed(int32_t annotation_hash, std::string_view destination) {
+  if (std::ranges::contains(kPageTraffic, annotation_hash)) {
+    return true;
+  }
+  const bool allowed = LogOnly();
+  LOG(WARNING) << "CRGOST_EGRESS " << (allowed ? "pass" : "block")
+               << " annotation=" << annotation_hash
+               << " destination=" << destination;
+  return allowed;
+}
+
+}  // namespace net
diff --git a/net/base/crgost_egress.h b/net/base/crgost_egress.h
new file mode 100644
index 00000000000..3cdfc6f4e2c
--- /dev/null
+++ b/net/base/crgost_egress.h
@@ -0,0 +1,28 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_BASE_CRGOST_EGRESS_H_
+#define NET_BASE_CRGOST_EGRESS_H_
+
+#include <cstdint>
+#include <string_view>
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// Single egress gate of the network service. Requests, preconnects and sockets
+// are admitted by traffic annotation hash: traffic of opened pages, the
+// network infrastructure it needs (DNS, proxy, certificate fetches),
+// suggestions of the default search engine and extension downloads started
+// by the user, forced by policy or required by a pending install pass, everything else is a browser
+// feature and is blocked. CRGOST_EGRESS=log lets everything pass. Every
+// decision outside page traffic is logged with the CRGOST_EGRESS prefix, the
+// annotation hash and the destination.
+NET_EXPORT bool CrgostEgressAllowed(int32_t annotation_hash,
+                                    std::string_view destination);
+
+}  // namespace net
+
+#endif  // NET_BASE_CRGOST_EGRESS_H_
