diff --git a/chrome/browser/extensions/updater/extension_updater.cc b/chrome/browser/extensions/updater/extension_updater.cc
index 2761ff5cf65..49bb4f8f839 100644
--- a/chrome/browser/extensions/updater/extension_updater.cc
+++ b/chrome/browser/extensions/updater/extension_updater.cc
@@ -439,6 +439,30 @@ void ExtensionUpdater::CheckNow(CheckParams params) {
   CHECK(alive_);
   CHECK(pending_extension_manager_);
 
+  // Update servers are contacted by the update button of chrome://extensions
+  // (foreground) and, in the background, only to complete installs forced by
+  // policy or shared module imports of an install started by the user.
+  if (params.fetch_priority != DownloadFetchPriority::kForeground) {
+    will_check_soon_ = false;
+    std::list<ExtensionId> pending_ids;
+    for (const ExtensionId& id :
+         pending_extension_manager_->GetPendingIdsForUpdateCheck()) {
+      const mojom::ManifestLocation source =
+          pending_extension_manager_->GetById(id)->install_source();
+      if (source == mojom::ManifestLocation::kExternalPolicyDownload ||
+          source == mojom::ManifestLocation::kInternal) {
+        pending_ids.push_back(id);
+      }
+    }
+    if (pending_ids.empty()) {
+      if (params.callback) {
+        std::move(params.callback).Run();
+      }
+      return;
+    }
+    params.ids = std::move(pending_ids);
+  }
+
   int request_id = next_request_id_++;
   VLOG(2) << "Starting update check " << request_id;
 
