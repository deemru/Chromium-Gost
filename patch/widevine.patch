diff --git a/chrome/browser/media/widevine_install_infobar_delegate.cc b/chrome/browser/media/widevine_install_infobar_delegate.cc
new file mode 100644
index 00000000000..c32fce94c5b
--- /dev/null
+++ b/chrome/browser/media/widevine_install_infobar_delegate.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/media/widevine_install_infobar_delegate.h"
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "build/build_config.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/component_updater/widevine_cdm_component_installer.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/component_updater/component_updater_service.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "components/strings/grit/components_strings.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kWidevineComponentId[] = "oimompecagnajdejgnnjijobebaeigek";
+constexpr char kLearnMoreUrl[] =
+    "https://github.com/deemru/Chromium-Gost/issues/147";
+
+enum class State { kIdle, kDeclined, kInstalling, kInstalled };
+State g_state = State::kIdle;
+
+bool IsWidevineInstalled() {
+  for (const auto& info :
+       g_browser_process->component_updater()->GetComponents()) {
+    if (info.id == kWidevineComponentId) {
+      return info.version.IsValid() && info.version != base::Version("0.0.0.0");
+    }
+  }
+  return false;
+}
+
+void ShowInfoBar(content::WebContents* web_contents,
+                 std::unique_ptr<ConfirmInfoBarDelegate> delegate) {
+  auto* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents);
+  if (manager) {
+    manager->AddInfoBar(CreateConfirmInfoBar(std::move(delegate)));
+  }
+}
+
+class WidevineInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  WidevineInfoBarDelegate(std::u16string message, int buttons)
+      : message_(std::move(message)), buttons_(buttons) {}
+
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    return CRGOST_WIDEVINE_INFOBAR_DELEGATE;
+  }
+  const gfx::VectorIcon& GetVectorIcon() const override {
+    return vector_icons::kInfoIcon;
+  }
+  std::u16string GetMessageText() const override { return message_; }
+  int GetButtons() const override { return buttons_; }
+  std::u16string GetLinkText() const override {
+    return l10n_util::GetStringUTF16(IDS_LEARN_MORE);
+  }
+  GURL GetLinkURL() const override { return GURL(kLearnMoreUrl); }
+  bool ShouldShowLinkBeforeButton() const override { return true; }
+
+ private:
+  const std::u16string message_;
+  const int buttons_;
+};
+
+#if BUILDFLAG(IS_LINUX)
+// The zygote loads CDMs before entering the sandbox, so a new CDM needs a
+// browser restart.
+class InstalledInfoBarDelegate : public WidevineInfoBarDelegate {
+ public:
+  explicit InstalledInfoBarDelegate(content::WebContents* web_contents)
+      : WidevineInfoBarDelegate(
+            l10n_util::GetStringUTF16(IDS_CRGOST_WIDEVINE_RESTART_PROMPT),
+            BUTTON_OK) {}
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return l10n_util::GetStringUTF16(IDS_CRGOST_WIDEVINE_RESTART);
+  }
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+  bool Accept() override {
+    chrome::AttemptRelaunch();
+    return false;
+  }
+};
+#else
+class InstalledInfoBarDelegate : public WidevineInfoBarDelegate {
+ public:
+  explicit InstalledInfoBarDelegate(content::WebContents* web_contents)
+      : WidevineInfoBarDelegate(
+            l10n_util::GetStringUTF16(IDS_CRGOST_WIDEVINE_RELOAD_PROMPT),
+            BUTTON_OK),
+        web_contents_(web_contents->GetWeakPtr()) {}
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return l10n_util::GetStringUTF16(IDS_RELOAD);
+  }
+  bool Accept() override {
+    if (web_contents_) {
+      web_contents_->GetController().Reload(content::ReloadType::NORMAL, true);
+    }
+    return true;
+  }
+
+ private:
+  base::WeakPtr<content::WebContents> web_contents_;
+};
+#endif
+
+void OnDownloaded(base::WeakPtr<content::WebContents> web_contents,
+                  update_client::Error error) {
+  const bool installed = IsWidevineInstalled();
+#if BUILDFLAG(IS_LINUX)
+  g_state = installed ? State::kInstalled : State::kIdle;
+#else
+  g_state = State::kIdle;
+#endif
+  if (!web_contents) {
+    return;
+  }
+  if (installed) {
+    ShowInfoBar(web_contents.get(),
+                std::make_unique<InstalledInfoBarDelegate>(web_contents.get()));
+  } else {
+    ShowInfoBar(
+        web_contents.get(),
+        std::make_unique<WidevineInfoBarDelegate>(
+            l10n_util::GetStringUTF16(IDS_CRGOST_WIDEVINE_DOWNLOAD_FAILED),
+            ConfirmInfoBarDelegate::BUTTON_NONE));
+  }
+}
+
+class InstallInfoBarDelegate : public WidevineInfoBarDelegate {
+ public:
+  explicit InstallInfoBarDelegate(content::WebContents* web_contents)
+      : WidevineInfoBarDelegate(
+            l10n_util::GetStringUTF16(IDS_CRGOST_WIDEVINE_INSTALL_PROMPT),
+            BUTTON_OK),
+        web_contents_(web_contents->GetWeakPtr()) {}
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return l10n_util::GetStringUTF16(IDS_CRGOST_WIDEVINE_DOWNLOAD);
+  }
+  bool Accept() override {
+    if (g_state == State::kInstalling) {
+      return true;
+    }
+    if (IsWidevineInstalled()) {
+      OnDownloaded(web_contents_, update_client::Error::NONE);
+      return true;
+    }
+    g_state = State::kInstalling;
+    component_updater::UpdateWidevineCdmComponentOnDemand(
+        base::BindOnce(&OnDownloaded, web_contents_));
+    return true;
+  }
+  void InfoBarDismissed() override {
+    if (g_state == State::kIdle) {
+      g_state = State::kDeclined;
+    }
+    ConfirmInfoBarDelegate::InfoBarDismissed();
+  }
+
+ private:
+  base::WeakPtr<content::WebContents> web_contents_;
+};
+
+}  // namespace
+
+void MaybeShowWidevineInstallInfoBar(content::RenderFrameHost* frame) {
+  auto* web_contents = content::WebContents::FromRenderFrameHost(frame);
+  if (!web_contents) {
+    return;
+  }
+  if (g_state == State::kInstalled) {
+    ShowInfoBar(web_contents,
+                std::make_unique<InstalledInfoBarDelegate>(web_contents));
+    return;
+  }
+  if (g_state != State::kIdle || IsWidevineInstalled()) {
+    return;
+  }
+  ShowInfoBar(web_contents,
+              std::make_unique<InstallInfoBarDelegate>(web_contents));
+}
