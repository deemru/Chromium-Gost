   return std::make_unique<ConfirmInfoBarWithNormalLabel>(std::move(delegate));
 }
 
+namespace {
+
+// Matches the visible gap between the 20 px infobar icon, centered in its
+// 24 px slot, and the message.
+int InfoBarControlSpacing() {
+  return ChromeLayoutProvider::Get()->GetDistanceMetric(
+             DISTANCE_INFOBAR_HORIZONTAL_ICON_LABEL_PADDING) +
+         2;
+}
+
+}  // namespace
+
 template <typename T>
 T* ConfirmInfoBar::AssignMessageLabel(std::unique_ptr<T> view) {
   auto* message_label = content_container()->AddChildViewAt(std::move(view), 0);
   int kHorizontalDistanceLabel = ChromeLayoutProvider::Get()->GetDistanceMetric(
       views::DISTANCE_UNRELATED_CONTROL_HORIZONTAL);
   if (GetDelegate()->ShouldShowLinkBeforeButton()) {
-    kHorizontalDistanceLabel = 4;
+    kHorizontalDistanceLabel = InfoBarControlSpacing();
   }
   // Set horizontal distance for label for flex layout.
   message_label->SetProperty(views::kMarginsKey,
@@ -156,8 +168,13 @@ ConfirmInfoBar::ConfirmInfoBar(std::unique_ptr<ConfirmInfoBarDelegate> delegate)
     }
     link_->SetProperty(views::kFlexBehaviorKey, kRigidFlex);
     // Add margins for spacing for flex layout.
-    link_->SetProperty(views::kMarginsKey, std::make_unique<gfx::Insets>(
-                                               gfx::Insets::TLBR(0, 0, 0, 0)));
+    const int leading_spacing =
+        delegate_ptr->ShouldShowLinkBeforeButton()
+            ? InfoBarControlSpacing()
+            : 0;
+    link_->SetProperty(views::kMarginsKey,
+                       std::make_unique<gfx::Insets>(
+                           gfx::Insets::TLBR(0, leading_spacing, 0, 0)));
   }
 }
 
diff --git a/components/component_updater/component_updater_service.cc b/components/component_updater/component_updater_service.cc
index 4fcff02bf34..7c624064bf7 100644
--- a/components/component_updater/component_updater_service.cc
+++ b/components/component_updater/component_updater_service.cc
@@ -202,7 +202,48 @@ void CrxUpdateService::Stop() {
 // it will be replaced.
 bool CrxUpdateService::RegisterComponent(
     const ComponentRegistration& component) {
-  return false;
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Widevine CDM is the only component; it is fetched on demand only.
+  if (component.app_id != "oimompecagnajdejgnnjijobebaeigek") {
+    return false;
+  }
+  if (component.app_id.empty() || !component.version.IsValid() ||
+      !component.installer) {
+    return false;
+  }
+
+  // Cancel any pending unregistration for this component.
+  std::erase(components_pending_unregistration_, component.app_id);
+
+  // Update the registration data if the component has been registered before.
+  auto it = components_.find(component.app_id);
+  if (it != components_.end()) {
+    it->second = component;
+    return true;
+  }
+
+  components_.insert(std::make_pair(component.app_id, component));
+  components_order_.push_back(component.app_id);
+
+  // Create an initial state for this component. The state is mutated in
+  // response to events from the UpdateClient instance.
+  CrxUpdateItem item;
+  item.id = component.app_id;
+  item.component = ToCrxComponent(component);
+  const auto [unused, inserted] =
+      component_states_.insert(std::make_pair(component.app_id, item));
+  CHECK(inserted);
+
