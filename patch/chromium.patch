+  base::ThreadPool::PostTask(FROM_HERE, { base::TaskPriority::USER_VISIBLE, base::MayBlock() },
+    base::BindOnce(&SSLClientSocketImpl::VerifyGOSTTask, weak_factory_.GetWeakPtr(), worker,
+                   base::ScopedClosureRunner(base::BindOnce(&gostssl_verify_release, worker)),
+                   base::SequencedTaskRunner::GetCurrentDefault()));
+  cert_verification_result_ = ERR_IO_PENDING;
+  return true;
