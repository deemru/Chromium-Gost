 #if BUILDFLAG(IS_CHROMEOS)
 #include "ash/constants/ash_features.h"
@@ -199,6 +201,51 @@ bool* g_discard_domain_reliability_uploads_for_testing = nullptr;
 const char kHttpCacheFinchExperimentGroups[] =
     "profile_network_context_service.http_cache_finch_experiment_groups";
 
+constexpr char kSkipBundledCaCertificates[] =
+    "skip-bundled-ca-certificates";
+
+enum class BundledCaCertificateRole {
+  kTrustAnchor,
+  kIntermediate,
+};
+
+struct BundledCaCertificate {
+  int resource_id;
+  BundledCaCertificateRole role;
+};
+
+constexpr BundledCaCertificate kBundledCaCertificates[] = {
+    {IDR_RUSSIAN_TRUSTED_ROOT_CA,
+     BundledCaCertificateRole::kTrustAnchor},
+    {IDR_RUSSIAN_TRUSTED_SUB_CA,
+     BundledCaCertificateRole::kIntermediate},
+    {IDR_RUSSIAN_TRUSTED_SUB_CA_2024,
+     BundledCaCertificateRole::kIntermediate},
+};
+
+void AddBundledCaCertificates(
+    cert_verifier::mojom::AdditionalCertificates& certificates) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kSkipBundledCaCertificates)) {
+    return;
+  }
+
+  const ui::ResourceBundle& resources =
+      ui::ResourceBundle::GetSharedInstance();
+  for (const auto& certificate : kBundledCaCertificates) {
+    std::vector<uint8_t> der = base::ToVector(base::as_byte_span(
+        resources.GetRawDataResource(certificate.resource_id)));
+    CHECK(!der.empty());
+
+    if (certificate.role == BundledCaCertificateRole::kTrustAnchor) {
+      certificates.trust_anchors_with_enforced_constraints.push_back(
+          std::move(der));
+    } else {
+      certificates.all_certificates.push_back(std::move(der));
+    }
+  }
+}
+
 std::vector<std::string> TranslateStringArray(const base::ListValue& list) {
   std::vector<std::string> strings;
   for (const base::Value& value : list) {
@@ -775,6 +822,8 @@ ProfileNetworkContextService::GetCertificatePolicy(
   auto additional_certificates =
       cert_verifier::mojom::AdditionalCertificates::New();
 
+  AddBundledCaCertificates(*additional_certificates);
+
 #if BUILDFLAG(IS_CHROMEOS)
   const policy::PolicyCertService* policy_cert_service =
       policy::PolicyCertServiceFactory::GetForProfile(profile_);
