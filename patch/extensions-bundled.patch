 #if !BUILDFLAG(IS_ANDROID)
 #include "chrome/browser/ui/startup/focus/focus_handler.h"
 #endif
@@ -650,6 +659,92 @@ std::optional<bool> MaybeHandleValidateCrx(
   return false;
 }
 
+#ifndef NO_GOSTSSL
+struct BundledExtension {
+  const char* name;
+  const char* skip_switch;
+  const char* version;
+  const char* id;
+  const char* public_key;
+  bool disable_notifications;
+};
+
+constexpr BundledExtension kBundledExtensions[] = {
+    {"plugin v2", "skip-bundled-plugin", "1.2.13",
+     "iifchhfnnmpdbibifmljnfjhpififfog",
+     "",
+     false},
+    {"plugin v3", "skip-bundled-plugin", "1.3.17",
+     "pfhgbfnnjiafkhfdkmpiflachepdcjod",
+     "",
+     false},
+    {"gosuslugi", "skip-bundled-gosuslugi", "1.2.8",
+     "pbefkdcndngodfeigfdgiodgnmbgcfha",
+     "",
+     false},
+    {"gosplugin", "skip-bundled-gosplugin", "1.3.43.0",
+     "jabjbhgjaidecageckilhonbggakppme",
+     "",
+     true},
+};
+
+void InstallBundledExtension(Profile* profile,
+                             const BundledExtension& bundled_extension) {
+  const extensions::Extension* installed =
+      extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(
+          bundled_extension.id);
+  if (installed &&
+      installed->version().CompareTo(base::Version(bundled_extension.version)) >=
+          0) {
+    return;
+  }
+
+  base::span<const uint8_t> crx_data =
+      chromium_gost::GetBundledExtensionCrx(bundled_extension.id);
+  base::FilePath crx_path;
+  if (crx_data.empty() || !base::CreateTemporaryFile(&crx_path) ||
+      !base::WriteFile(crx_path, crx_data)) {
+    if (!crx_path.empty()) {
+      base::DeleteFile(crx_path);
+    }
+    LOG(ERROR) << "Cannot materialize bundled " << bundled_extension.name;
+    return;
+  }
+
+  std::string crx_id;
+  std::string crx_public_key;
+  const crx_file::VerifierResult verifier_result = crx_file::Verify(
+      crx_path, crx_file::VerifierFormat::CRX3, {}, {}, &crx_public_key,
+      &crx_id, nullptr);
+  if (verifier_result != crx_file::VerifierResult::OK_FULL ||
+      crx_id != bundled_extension.id ||
+      crx_public_key != bundled_extension.public_key) {
+    base::DeleteFile(crx_path);
+    LOG(ERROR) << "Bundled " << bundled_extension.name
+               << " failed CRX verification";
+    return;
+  }
+
+  scoped_refptr<extensions::CrxInstaller> installer =
+      extensions::CrxInstaller::CreateSilent(profile);
+  installer->set_grant_permissions(true);
+  installer->set_allow_silent_install(true);
+  installer->set_install_immediately(true);
+  installer->set_off_store_install_allow_reason(
+      extensions::CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+  installer->set_delete_source(true);
+
+  if (bundled_extension.disable_notifications) {
+    message_center::NotifierId notifier_id(
+        message_center::NotifierType::APPLICATION, bundled_extension.id);
+    NotifierStateTrackerFactory::GetForProfile(profile)->SetNotifierEnabled(
+        notifier_id, false);
+  }
+
+  installer->InstallCrx(crx_path);
+}
+#endif  // NO_GOSTSSL
+
 }  // namespace
 
 StartupBrowserCreator::StartupBrowserCreator() = default;
@@ -713,6 +808,14 @@ void StartupBrowserCreator::LaunchBrowser(
   profile = GetPrivateProfileIfRequested(
       command_line, {profile, StartupProfileMode::kBrowserWindow});
 
+#ifndef NO_GOSTSSL
+  for (const BundledExtension& bundled_extension : kBundledExtensions) {
+    if (!command_line.HasSwitch(bundled_extension.skip_switch)) {
+      InstallBundledExtension(profile, bundled_extension);
+    }
+  }
+#endif  // NO_GOSTSSL
+
   if (!IsSilentLaunchEnabled(command_line, profile)) {
 #if BUILDFLAG(ENABLE_DICE_SUPPORT)
     auto* fre_service = FirstRunServiceFactory::GetForBrowserContext(profile);
