diff --git a/chrome/browser/profiles/profile_attributes_storage.cc b/chrome/browser/profiles/profile_attributes_storage.cc
index bba21bed411..60aa2b1592b 100644
--- a/chrome/browser/profiles/profile_attributes_storage.cc
+++ b/chrome/browser/profiles/profile_attributes_storage.cc
@@ -309,6 +309,23 @@ ProfileAttributesStorage::ProfileAttributesStorage(
     entry->InitializeLastNameToDisplay();
   }
 
+  // A default name containing the product name follows the UI language.
+  const std::u16string placeholder =
+      l10n_util::GetStringUTF16(IDS_PROFILE_MENU_PLACEHOLDER_PROFILE_NAME);
+  const std::u16string product = l10n_util::GetStringUTF16(IDS_PRODUCT_NAME);
+  for (ProfileAttributesEntry* entry : GetAllProfilesAttributes()) {
+    const std::u16string name = entry->GetLocalProfileName();
+    if (entry->IsUsingDefaultName() && name != placeholder &&
+        name.find(product) != std::u16string::npos &&
+        std::ranges::none_of(GetAllProfilesAttributes(),
+                             [&](ProfileAttributesEntry* other) {
+                               return other->GetLocalProfileName() ==
+                                      placeholder;
+                             })) {
+      entry->SetLocalProfileName(placeholder, /*is_default_name=*/true);
+    }
+  }
+
   // If needed, start downloading the high-res avatars and migrate any legacy
   // profile names.
   if (!disable_avatar_download_for_testing_)
