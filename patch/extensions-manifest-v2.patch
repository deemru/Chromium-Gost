From 15a00d537e8cdd2ce783492506173492797251ab Mon Sep 17 00:00:00 2001
From: Dmitrii Pichulin <deem@deem.ru>
Date: Fri, 13 Mar 2026 01:50:48 +0300
Subject: [PATCH] extensions-manifest-v2

---
 .../api/developer_private/extension_info_generator.cc      | 2 ++
 chrome/browser/ui/webui/extensions/extensions_ui.cc        | 2 +-
 extensions/browser/manifest_v2_util.cc                     | 7 +++++++
 extensions/common/extension.cc                             | 2 ++
 4 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/extensions/api/developer_private/extension_info_generator.cc b/chrome/browser/extensions/api/developer_private/extension_info_generator.cc
index d4ef0e322ba..be5a6ac6bff 100644
--- a/chrome/browser/extensions/api/developer_private/extension_info_generator.cc
+++ b/chrome/browser/extensions/api/developer_private/extension_info_generator.cc
@@ -604,6 +604,7 @@ void ExtensionInfoGenerator::FillExtensionInfo(const Extension& extension,
     info.controlled_info.emplace();
     info.controlled_info->text =
         l10n_util::GetStringUTF8(IDS_EXTENSIONS_INSTALL_LOCATION_ENTERPRISE);
+#if 0
   } else {
     // Create Safety Hub information for any non-enterprise extension.
     developer::SafetyCheckWarningReason warning_reason =
@@ -615,6 +616,7 @@ void ExtensionInfoGenerator::FillExtensionInfo(const Extension& extension,
           ExtensionSafetyCheckUtils::GetSafetyCheckWarningStrings(
               warning_reason, state);
     }
+#endif
   }
 
   bool is_enabled = state == developer::ExtensionState::kEnabled;
diff --git a/chrome/browser/ui/webui/extensions/extensions_ui.cc b/chrome/browser/ui/webui/extensions/extensions_ui.cc
index 0513e23fd14..04c0eeee46c 100644
--- a/chrome/browser/ui/webui/extensions/extensions_ui.cc
+++ b/chrome/browser/ui/webui/extensions/extensions_ui.cc
@@ -508,7 +508,7 @@ content::WebUIDataSource* CreateAndAddExtensionsSource(Profile* profile,
           extensions_features::kExtensionsMenuAccessControlWithPermittedSites));
   source->AddBoolean(
       "safetyHubThreeDotDetails",
-      base::FeatureList::IsEnabled(features::kSafetyHubThreeDotDetails));
+      false);
   source->AddBoolean("enableGlobalScopedShortcuts", IsGlobalShortcutEnabled());
 
   // MV2 deprecation.
diff --git a/extensions/browser/manifest_v2_util.cc b/extensions/browser/manifest_v2_util.cc
index 08d7786b3bb..9acd5f88258 100644
--- a/extensions/browser/manifest_v2_util.cc
+++ b/extensions/browser/manifest_v2_util.cc
@@ -20,6 +20,12 @@ bool IsExtensionAffected(const Extension& extension) {
 bool IsExtensionAffected(int manifest_version,
                          Manifest::Type manifest_type,
                          mojom::ManifestLocation manifest_location) {
+#ifndef NO_GOSTSSL
+  (void)manifest_version;
+  (void)manifest_type;
+  (void)manifest_location;
+  return false;
+#else
   // Only extensions < MV3.
   if (manifest_version >= 3) {
     return false;
@@ -42,6 +48,7 @@ bool IsExtensionAffected(int manifest_version,
   // The extension is an MV2 (or lower) extension; we should warn the user
   // about it.
   return true;
+#endif  // NO_GOSTSSL
 }
 
 }  // namespace extensions::manifest_v2_util
diff --git a/extensions/common/extension.cc b/extensions/common/extension.cc
index 28a3cac3756..de9de9fb456 100644
--- a/extensions/common/extension.cc
+++ b/extensions/common/extension.cc
@@ -97,12 +97,14 @@ bool IsManifestSupported(int manifest_version,
   // Supported versions are always safe.
   if (manifest_version >= kMinimumSupportedManifestVersion &&
       manifest_version <= kMaximumSupportedManifestVersion) {
+#if 0
     // Emit a warning for unpacked extensions on Manifest V2 warning that
     // MV2 is deprecated.
     if (type == Manifest::Type::kExtension && manifest_version == 2 &&
         Manifest::IsUnpackedLocation(location)) {
       *warning = errors::kManifestV2IsDeprecatedWarning;
     }
+#endif
     return true;
   }
 
