diff --git a/chrome/installer/linux/rpm/additional_deps b/chrome/installer/linux/rpm/additional_deps
index d6080c3a460..47e74211680 100644
--- a/chrome/installer/linux/rpm/additional_deps
+++ b/chrome/installer/linux/rpm/additional_deps
@@ -11,7 +11,7 @@ ca-certificates
 liberation-fonts
 
 # GTK is dlopen()'ed.  Versions 3 or 4 are supported.
-(libgtk-3.so.0()(64bit) or libgtk-4.so.1()(64bit))
+libgtk-3.so.0()(64bit)
 
 # Specify a more recent version for security and stability updates.
 libnss3.so(NSS_3.39)(64bit)
@@ -20,14 +20,13 @@ libnss3.so(NSS_3.39)(64bit)
 # of expected dependencies when Chrome is built with the older versions, add it
 # as a manual dependency.
 rpmlib(FileDigests) <= 4.6.0-1
-rpmlib(RichDependencies) <= 4.12.0-1
 
